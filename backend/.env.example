# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=aft
PGPASSWORD=aft_cmg_secreto
PGDATABASE=aft_cmg
PGSSL=false

# O bien, una cadena de conexión completa que tiene prioridad:
# DATABASE_URL=postgres://aft:clave@host:5432/aft_cmg?sslmode=disable

# Seguridad
JWT_SECRET=cambia-esto-por-un-secreto-largo
TOKEN_TTL=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# App
PORT=8080
CORS_ORIGIN=*
# Saltos de proxy delante de la app. En Dokploy es 1 (Traefik con https):
# hace falta para que el callback de Accesos salga con https y la cookie
# quede `secure`. En local, sin proxy, déjalo como está.
TRUST_PROXY=1

# Accesos (SSO) — https://auth.procovar.cloud
# Ojo: en Accesos NO se registra nada desde esta aplicación, sólo se consume su
# API. El ClientApp (clientId, signingKey y las allowedCallbackUrls —
# https://aft.procovar.cloud/api/auth/sso/callback y la de local) lo da de alta Jose.
# La clave NO va en este fichero, ni en un chat, ni en el repositorio: se la
# pides a Jose, que la guarda en procovar/.secretos. En Dokploy es variable de
# entorno de la aplicación. Se lee en HEXADECIMAL, no como texto plano.
# Sin clave no se revienta: se entra por el login local de abajo.
AFT_AUTH_URL=https://auth.procovar.cloud
AFT_AUTH_CLIENT_ID=aft
AFT_AUTH_SIGNING_KEY=